# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!/.env.example

# agent skills (installed locally, not versioned)
/.agents/
/.claude/skills/
/skills-lock.json

# design reference assets (kept local)
/design/

# sanity studio workspace
!/studio/.env.example
/studio/dist/
/studio/.sanity/
/studio/schema.json
/studio/node_modules/

# Local-only review copies quoting third-party transcripts in full (never commit)
docs/evals/local/
