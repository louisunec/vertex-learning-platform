# Clerk — https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Sanity — https://www.sanity.io/manage → project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-31
# Viewer token for server-only reads. Optional while the dataset is public;
# required once it is made private. Never exposed to the browser.
SANITY_API_READ_TOKEN=

# PostHog — project settings → project API key
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=your_posthog_host_here
# Server-only. Project Secret API key (phs_…) or Personal API key (phx_…) for
# local feature-flag evaluation. Optional: without it each flag check is a
# remote request; flags fail closed (off) on errors.
POSTHOG_SECRET_KEY=

# Search — server-side only, never exposed to the browser.
# SANITY_API_READ_TOKEN (above) is required for search: it authenticates the
# Sanity Context MCP (requires a deployed Studio).
# OpenAI API key for query interpretation; without it search degrades to
# deterministic keyword matching.
OPENAI_API_KEY=
# Slug of the published sanity.agentContext document scoping the Context MCP.
# Leave empty to use the unscoped base MCP endpoint.
SANITY_CONTEXT_SLUG=vertex-search
# Optional request-path timeout overrides in ms (1000–60000; invalid values use
# the defaults in lib/timeouts.ts: 10000 for the AI gateway, 8000 for the MCP).
AI_GATEWAY_TIMEOUT_MS=
MCP_TIMEOUT_MS=

# Offline tooling only (npm run ingest:videos, npm run generate:assessments,
# npm run index:visuals), never read by the app. Token needs Editor access to
# write `video`, draft `assessment`, and `videoVisualIndex` documents.
# Generation and the visual index's VLM also use OPENAI_API_KEY (above).
SANITY_API_WRITE_TOKEN=

# Visual index (npm run index:visuals) — offline tooling only, never read by
# the app. Per-video caps; hitting one records a skipped span and marks the
# index partial. Invalid values fall back to the defaults in lib/visual/budget.ts.
VISUAL_MAX_FRAMES=
VISUAL_MAX_OCR_FRAMES=
VISUAL_MAX_VLM_CALLS=
VISUAL_MAX_WALL_MS=
VISUAL_MAX_SPEND_USD=
# VLM price table (USD per million tokens; defaults are gpt-5-mini list
# prices; check current provider pricing) and the worst-case input tokens per
# call used for the pre-call spend check.
VISUAL_VLM_INPUT_USD_PER_MTOK=
VISUAL_VLM_OUTPUT_USD_PER_MTOK=
VISUAL_VLM_ESTIMATED_INPUT_TOKENS=
# Sampling and gate tuning (defaults: 2 s periodic frames, 0.3 scene score, 0.6 gate).
VISUAL_PERIODIC_SECONDS=
VISUAL_SCENE_THRESHOLD=
VISUAL_VLM_GATE_THRESHOLD=
# Optional tool paths when ffmpeg/ffprobe/Chrome are not on PATH (Chrome is
# only used to render test fixtures).
FFMPEG_PATH=
FFPROBE_PATH=
CHROME_PATH=
